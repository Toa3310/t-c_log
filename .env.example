# このファイルを .env にコピーして値を設定してください（.env は Git に入れない）

# 進行中のタスクを入れる Cookie の暗号化に使う秘密鍵。長いランダムな文字列にする
#   例: openssl rand -hex 32 の出力
SECRET_KEY=change-me

# SQLite のデータベースファイル（cargo run を実行する場所からの相対パス）。
# Docker では使わない（コンテナ内の /data/tascon.db に固定）
DB_PATH=tascon.db

# cargo run で待ち受けるアドレス。Vite の開発サーバー（npm run dev）もこの値を見て /api を転送する。
# 8080 を別のアプリが使っている場合は空いている番号に変える
ADDR=127.0.0.1:8080

# docker compose で公開するアドレスとポート（http://<TASCON_BIND>:<TASCON_PORT>）。
# 既定はこの PC だけ（127.0.0.1）。Tailscale で他の端末から使うなら `tailscale ip -4` の IP にする。
# ログイン機能が無いので、0.0.0.0（すべてのネットワーク）にはしないこと
TASCON_BIND=127.0.0.1
# 8080 を別のアプリが使っている場合は空いている番号に変える
TASCON_PORT=8080
